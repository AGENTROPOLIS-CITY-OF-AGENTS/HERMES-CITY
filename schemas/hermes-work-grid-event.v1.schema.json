{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.local/schemas/hermes-work-grid-event.v1.schema.json",
  "title": "Hermes Work Grid Event v1",
  "description": "Sanitized host-local Hermes Kanban event projected to AGENTROPOLIS Mission Control. This event is evidence/projection, not an authority grant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "node_id",
    "board_slug",
    "task_id",
    "task_state",
    "authority_mode",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "event_type": {
      "type": "string",
      "enum": [
        "task.created",
        "task.claimed",
        "task.blocked",
        "task.scheduled",
        "task.promoted",
        "task.completed",
        "task.failed",
        "task.archived",
        "run.started",
        "run.finished",
        "task.heartbeat"
      ]
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "board_slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "task_state": {
      "type": "string",
      "enum": [
        "triage",
        "blocked",
        "scheduled",
        "ready",
        "running",
        "completed",
        "failed",
        "archived"
      ]
    },
    "assignee_profile": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "workspace": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "claim_expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "heartbeat_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "summary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "maxItems": 500
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          },
          "maxItems": 200
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "maxItems": 100
        },
        "open_risks": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "maxItems": 100
        },
        "receipt_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "maxItems": 100
        }
      }
    },
    "authority_mode": {
      "const": "observational"
    },
    "authority_envelope_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
